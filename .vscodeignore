# Exclude development/build tooling - NOT shipped in extension
.vscode/**
.gitignore
.gitattributes
node_modules/**
archive/**

# Source icons (raw/unprocessed) - NOT shipped
source-icons/**

# Build pipeline scripts - NOT shipped
pipeline/**
Tools/**
Core/**
utils/**
automoation/**
config/**
logs/**
registry/**

# Misc
*.vsix
version.txt
readme.md

# -----------------------------------------------
# IMPORTANT: processed-icons/ is NOT listed here
# It MUST be included in the VSIX so VS Code can
# find the PNG files referenced in icons-theme.json
# -----------------------------------------------
